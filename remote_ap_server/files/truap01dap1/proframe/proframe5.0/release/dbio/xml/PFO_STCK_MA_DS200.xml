    <sqlString xmlns="">SELECT /*+PFO_STCK_MA_DS200*/
       listagg(itms_name, ',') itms_name
  FROM (SELECT t1.*
             , row_number() over(ORDER BY vlamt desc) sort
          FROM (SELECT '주식' ast_dncd
                     , t1.itms_code
                     , t2.itms_name
                     , t1.prdy_acqs_amt + t1.incr_acqs_amt - t1.dcrs_acqs_amt + t1.pbic_acqs_amt - t1.pbdc_acqs_amt AS vlamt
                  FROM pfo_stck_ma t1
                     , tru_stck_itms_ht t2
                 WHERE 1=1
                   AND t2.proc_date = t1.proc_date
                   AND t2.itms_code = t1.itms_code
                   AND t1.mncm_code = :mncm_code
                   AND t1.proc_date = :proc_date
                   AND t1.fund_code = :fund_code
                 UNION ALL
                SELECT '차입주식' ast_dncd
                     , t1.itms_code
                     , t2.itms_name
                     , t1.prdy_slng_amt          /* 전일매도금액 */
                     + t1.incr_slng_stcn         /* 증가매도주수 */
                     - t1.dcrs_slng_stcn         /* 감소매도주수 */
                     - t1.vprl_amt - t1.asprl_amt AS vlamt /* 평가금액 */
                  FROM pfo_brwn_stck_ma t1
                     , tru_stck_itms_ht t2
                 WHERE 1=1
                   AND t2.proc_date = t1.proc_date
                   AND t2.itms_code = t1.itms_code
                   AND t1.mncm_code = :mncm_code
                   AND t1.proc_date = :proc_date
                   AND t1.fund_code = :fund_code
                 UNION ALL
                SELECT '대주' ast_dncd
                     , t1.itms_code
                     , t2.itms_name
                     , t1.vlamt AS vlamt         /* 평가금액 */
                  FROM pfo_spa_ma t1
                     , pfo_spa_itms_ht t2
                 WHERE 1=1
                   AND t2.mncm_code = t1.mncm_code
                   AND t2.proc_date = t1.proc_date
                   AND t2.itms_code = t1.itms_code
                   AND t1.mncm_code = :mncm_code
                   AND t1.proc_date = :proc_date
                   AND t1.fund_code = :fund_code
                 UNION ALL
                SELECT '보유종목없음'
                     , '보유종목없음'
                     , '보유종목없음'
                     , -99999
                  FROM DUAL ) t1 )
 WHERE 1=1
   AND sort &lt;= 3</sqlString>
