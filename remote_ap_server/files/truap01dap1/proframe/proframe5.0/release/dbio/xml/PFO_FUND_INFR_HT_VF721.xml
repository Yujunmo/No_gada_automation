    <sqlString xmlns="">select t1.mncm_code
     , t1.fund_code
     , t1.trst_dncd
     , t1.trteco_code
  from pfo_fund_infr_ht t1
 where t1.mncm_code = :mncm_code
   and t1.proc_date between :strn_date and :end_date
   and t1.fund_code like decode(:fund_code, '*', '%', :fund_code)
   and t1.trst_dncd like decode(:trst_dncd, '*', '%', :trst_dncd)
   and t1.trteco_code like decode(:trteco_code, '*', '%', :trteco_code)</sqlString>
