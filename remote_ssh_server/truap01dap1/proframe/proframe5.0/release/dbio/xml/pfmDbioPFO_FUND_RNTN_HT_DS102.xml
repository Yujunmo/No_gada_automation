    <sqlString xmlns="">select t1.mncm_code
     , t1.fund_code
     , t1.proc_date
     , t2.nav_amt
     , t3.revs_stpr
  from pfo_fund_ht t1
     , pfo_tami_sm t2
     , pfo_clfd_revs_stpr_ma t3
 where t1.mncm_code = :mncm_code
   and t1.fund_code = :fund_code
   and t1.proc_date between :strn_date and :end_date
   and t1.mncm_code = t2.mncm_code
   and t1.fund_code = t2.fund_code
   and t1.proc_date = t2.proc_date
   and t1.mncm_code = t3.mncm_code
   and t1.fund_code = t3.fund_code
   and t1.proc_date = t3.proc_date
 order by t1.proc_date</sqlString>
