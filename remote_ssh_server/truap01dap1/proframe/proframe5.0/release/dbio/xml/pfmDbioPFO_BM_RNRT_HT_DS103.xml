    <sqlString xmlns="">select t1.mncm_code
     , t1.bm_templt_code
     , t2.bm_templt_code_name
     , t1.strn_date
     , t3.revs_stpr
  from pfo_clfd_bm_templt_ht t1
     , pfo_bm_stup_templt_bs t2
     , pfo_clfd_revs_stpr_ma t3
 where t1.mncm_code = :mncm_code
   and t1.bm_templt_code = :bm_templt_code
   and t1.strn_date between :strn_date and :end_date
   and t1.mncm_code = t2.mncm_code
   and t1.bm_templt_code = t2.bm_templt_code
   and t1.mncm_code = t3.mncm_code
   and t1.strn_date = t3.proc_date
 order by t1.strn_date</sqlString>
