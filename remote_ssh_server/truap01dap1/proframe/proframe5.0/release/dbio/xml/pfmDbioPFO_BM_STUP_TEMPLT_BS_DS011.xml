    <sqlString xmlns="">SELECT /*PFO_BM_STUP_TEMPLT_BS_DS011*/
           t1.bm_templt_code_name as bm_templt_code_name
           , t1.bm_templt_code as bm_templt_code
           , t1.st1_formula_name || '('||nvl(t2.stck_wghn_formula_name , '-')||')' as st1_formula_cntn   /* 제1계 산식내용 */
           , t1.nd2_formula_name || '('||nvl(t2.bond_wghn_formula_name , '-')||')' as nd2_formula_cntn   /* 제2계 산식내용 */
           , t1.th3_formula_name || '('||nvl(t2.cash_wghn_formula_name , '-')||')' as th3_formula_cntn   /* 제3계 산식내용 */
           , t1.th4_formula_name || '('||nvl(t2.etc_wghn_formula_name , '-')||')' as th4_formula_cntn   /* 제4계 산식내용 */
        FROM pfo_clfd_bm_templt_ht  t1
           , pfo_bm_stup_templt_bs t2
       WHERE 1=1
         AND t1.mncm_code   = :mncm_code
         AND t1.fund_code   = :fund_code
         AND t1.strn_date = ( SELECT max(strn_date)
                                 FROM pfo_clfd_bm_templt_ht  tz
                                WHERE tz.mncm_code = t1.mncm_code
                                  AND tz.fund_code = t1.fund_code
                                  AND tz.strn_date &lt;= :end_date )
         AND t1.mncm_code = t2.mncm_code
         AND t1.bm_templt_code = t2.bm_templt_code</sqlString>
