    <sqlString xmlns="">select /*+AIS_ACCSUBJ_BS_VF001*/
       trgt_code
     , trgt_code_name
  from (select trgt_code, trgt_code_name
          from (select 'XXXXXX' as trgt_code, '이관안함' as trgt_code_name from dual
                union all
                select trgt_code, trgt_code_name
                  from (select t1.accsubj_code       as trgt_code
                             , case when :lngg_dtcd = 'KR' then t1.accsubj_ensn_uvnm else t1.accsubj_uvnm end as trgt_code_name
                          from ais_accsubj_bs t1
                         where t1.ais_fund_dncd = '1'
                         order by t1.accsubj_code))
         where (
                 (trgt_code like '%'||:srch_cntn||'%' )
              OR
                 (trgt_code_name like '%'||:srch_cntn||'%' )
               )
       )
 where trgt_code &gt;= :st1_key_brkd
   and rownum &lt;= :inqy_cscn + 1 /* 조회건수 */</sqlString>
