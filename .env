# 로컬 개발용 .env — 이 파일을 복사해 .env로 저장하고 값을 채운다 (.env는 gitignore됨)
#   cp .env.example .env


NOGADA_DB_HOST=127.0.0.1
NOGADA_DB_PORT=1521
NOGADA_DB_USER=testuser
NOGADA_DB_PASS=testpass
NOGADA_DB_NAME=NOGADA
NOGADA_DB_DIALECT=oracle+oracledb

# --- SFTP: remote_ap_server 기본값 ---
NOGADA_SFTP_HOST=127.0.0.1
NOGADA_SFTP_PORT=2222
NOGADA_SFTP_USER=testuser
NOGADA_SFTP_PASS=testpass
NOGADA_SFTP_BASE=src

# 원격 소스(SFTP 파일 읽기 + SSH 명령 실행) + 로컬 텍스트 파일(config/*.txt, logs/no_gada.log)
# 인코딩. 회사 반입 시 실제 서버 인코딩(예: euc-kr, cp949)으로 바꿀 것.
NOGADA_SOURCE_ENCODING=utf-8

# --- 경로 오버라이드 (기본값 그대로 쓰면 생략 가능) ---
# NOGADA_EXCLUDED_REFS_PATH=config/excluded_refs.txt
# NOGADA_MODULE_GROUP_MAP_PATH=config/module_group_map.txt
