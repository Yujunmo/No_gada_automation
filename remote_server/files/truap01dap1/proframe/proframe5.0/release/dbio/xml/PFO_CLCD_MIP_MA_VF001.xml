    <sqlString xmlns="">select t3.mncm_name,
       t2.fund_name,
       t1.nav_amt,
       t1.tot_amt,
       (select sum(stup_amt) from pfo_ear_tr tz where tz.mncm_code = t1.mncm_code and tz.fund_code = t1.fund_code and tz.proc_date between :strn_date and :end_date ) as stup_amt
  from pfo_clfd_mip_ma @dl_patru_Trups t1,
       pfo_fund_ht @dl_patru_Trups t2,
       tru_mncm_bs @dl_patru_Trups t3,
       fep_mjspok t4
 where t1.mncm_code = :mncm_code
   and t1.fund_code = :fund_code
   and t1.proc_Date between :strn_date and :end_date
   and t1.proc_date = t2.proc_date
   and t1.mncm_code = t2.mncm_code
   and t1.fund_code = t2.fund_code
   and t1.mncm_code = t3.mncm_code
   and t1.fund_code = t4.fund_code</sqlString>
